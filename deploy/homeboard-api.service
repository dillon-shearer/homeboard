[Unit]
Description=Home Board API server
After=network-online.target
Wants=network-online.target

[Service]
User=homeboard
Group=homeboard
WorkingDirectory=/opt/homeboard
Environment=HOMEBOARD_DATA=/var/lib/homeboard
ExecStart=/opt/homeboard/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
