[Unit]
Description=Home Board kiosk on the monitor
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service
Wants=homeboard-api.service nginx.service
Conflicts=getty@tty1.service

[Service]
User=dillon
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=-+/bin/systemctl stop homeboard-preload.service
ExecStart=/bin/bash /opt/homeboard/deploy/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
